generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Waitlist {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  whatsapp    String
  signupType  String
  city        String
  position    Int
  createdAt   DateTime @default(now())
}
